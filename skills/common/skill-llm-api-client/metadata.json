{
  "name": "skill-llm-api-client",
  "description": "統一的 LLM 客戶端函式庫（llm），封裝 Gemini API 金鑰輪轉、skill-llm-api-server 的 codex-cli/gemini-cli 橋接、以及本地 MLX 推論，內建 codex → gemini → mlx 自動備援鏈與智慧路由（Smart Routing）。",
  "category": "library",
  "version": "1.0.2",
  "author": "wenchiehlee",
  "maintainer": "wenchiehlee",
  "source": "https://github.com/wenchiehlee/llm",
  "updated_at": "2026-09-01",
  "license": "MIT",
  "tags": [
    "client",
    "llm",
    "gemini",
    "codex-cli",
    "mlx",
    "fallback-chain",
    "smart-routing",
    "amplitude",
    "python-library"
  ],
  "compatibility": {
    "python": ">=3.11",
    "requires": [
      "google-genai>=1.0.0",
      "httpx>=0.27.0"
    ],
    "env": [
      "GEMINI_API_KEY",
      "CODEX_API_URL",
      "CODEX_API_KEY",
      "MLX_API_URL",
      "MLX_SERVER_API_KEY"
    ]
  },
  "files": [
    "SKILL.md",
    "metadata.json",
    "self_update.py",
    "scripts/__init__.py",
    "scripts/client.py",
    "scripts/providers/__init__.py",
    "scripts/providers/codex.py",
    "scripts/providers/gemini.py",
    "scripts/providers/mlx.py",
    "scripts/analytics/__init__.py",
    "scripts/analytics/amplitude.py"
  ],
  "deployments": [
    {
      "repo": "wenchiehlee/skills",
      "local_path": "github.com/skills/common/skill-llm-api-client",
      "role": "registry"
    },
    {
      "repo": "wenchiehlee/llm",
      "local_path": "github.com/llm/skills/skill-llm-api-client",
      "role": "consumer"
    }
  ],
  "registry": "https://github.com/wenchiehlee/skills/tree/main/common/skill-llm-api-client"
}
